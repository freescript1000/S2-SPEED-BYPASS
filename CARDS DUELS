-- ============================================================
-- UPDATE VISUALS
-- ============================================================
local function updateVisuals()
    if CONFIG.Toggles.AntiBat then
        AntiBatButton.Text = "ANTI-BAT : ON"
        AntiBatButton.BackgroundColor3 = PINK.Black
        AntiBatButton.TextColor3 = PINK.Main
    else
        AntiBatButton.Text = "ANTI-BAT : OFF"
        AntiBatButton.BackgroundColor3 = PINK.Card
        AntiBatButton.TextColor3 = PINK.White
    end

    if CONFIG.Toggles.InfJump then
        InfJumpButton.Text = "INF JUMP : ON"
        InfJumpButton.BackgroundColor3 = PINK.Black
        InfJumpButton.TextColor3 = PINK.Main
    else
        InfJumpButton.Text = "INF JUMP : OFF"
        InfJumpButton.BackgroundColor3 = PINK.Card
        InfJumpButton.TextColor3 = PINK.White
    end
    
    kbBtn.Text = CONFIG.ToggleKey.Name
end

-- ============================================================
-- BUTTON EVENTS
-- ============================================================
AntiBatButton.MouseButton1Click:Connect(function()
    CONFIG.Toggles.AntiBat = not CONFIG.Toggles.AntiBat
    updateVisuals()
end)

InfJumpButton.MouseButton1Click:Connect(function()
    CONFIG.Toggles.InfJump = not CONFIG.Toggles.InfJump
    updateVisuals()
end)

-- ============================================================
-- COLLAPSE FUNCTION
-- ============================================================
local function toggleCollapse()
    isCollapsed = not isCollapsed
    
    if isCollapsed then
        collapseLine.Text = "+"
        collapseLine.TextColor3 = PINK.Light
        TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 150, 0, COLLAPSED_HEIGHT)
        }):Play()
        hiddenContent.Visible = false
    else
        collapseLine.Text = "-"
        collapseLine.TextColor3 = PINK.Main
        hiddenContent.Visible = true
        TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 150, 0, EXPANDED_HEIGHT)
        }):Play()
    end
end

collapseLine.MouseButton1Click:Connect(toggleCollapse)

-- ============================================================
-- KEYBIND LISTENER
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == CONFIG.ToggleKey then
        main.Visible = not main.Visible
    end
end)

-- ============================================================
-- INFINITE JUMP
-- ============================================================
UserInputService.JumpRequest:Connect(function()
    if CONFIG.Toggles.InfJump then
        local hrp = getHRP()
        if hrp then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 45, hrp.Velocity.Z)
        end
    end
end)

-- ============================================================
-- ANTI BAT
-- ============================================================
RunService.PostSimulation:Connect(function()
    if CONFIG.Toggles.AntiBat then
        local hrp = getHRP()
        if hrp then
            for _, child in ipairs(hrp:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
                    child:Destroy()
                elseif child:IsA("Velocity") then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end)

